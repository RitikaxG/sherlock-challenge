{
  "name": "@sherlock/eval",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "sherlock-eval": "./cli.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./cli": "./cli.ts",
    "./evaluator": "./evaluator.ts",
    "./metrics": "./metrics.ts",
    "./reporter": "./reporter.ts",
    "./scenario-loader": "./scenario-loader.ts",
    "./scenario-runner": "./scenario-runner.ts"
  },
  "scripts": {
